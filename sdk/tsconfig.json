{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "types":["node"],
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["test", "node_modules", "dist"]
}